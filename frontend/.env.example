# =====================================================================
# CODEMIND 10 - FRONTEND ENVIRONMENT VARIABLES
# Hướng dẫn: Copy file này thành .env trong thư mục frontend và điền
# các giá trị lấy từ Firebase Console -> Project Settings -> Your apps
# =====================================================================

# 1. Địa chỉ Backend Server (Mặc định khi chạy local là http://localhost:5000)
VITE_BACKEND_URL=http://localhost:5000

# 2. Cấu hình Google Firebase (Lấy tại Firebase Console)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
