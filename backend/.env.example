# =====================================================================
# CODEMIND 10 - BACKEND ENVIRONMENT VARIABLES
# Hướng dẫn: Đổi tên thành .env và điền các khóa bí mật của bạn
# =====================================================================

PORT=5000
GEMINI_MODEL=gemini-3.5-flash
APP_PASSCODE=TIN10_2026

# =====================================================================
# HỆ THỐNG 5 LUỒNG API KEY XOAY VÒNG & DỰ PHÒNG TỰ ĐỘNG (KEY POOL)
# - Phân bổ đều tải giữa các key (Round-Robin) nhân 5 lần hạn mức RPM
# - Tự động nhảy sang Key tiếp theo nếu 1 Key chạm Rate Limit (429)
# =====================================================================

# Luồng 1 (Khóa chính):
GEMINI_API_KEY_1=your_gemini_api_key_1_here

# Luồng 2 (Khóa phụ 2):
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# Luồng 3 (Khóa phụ 3):
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# Luồng 4 (Khóa phụ 4):
GEMINI_API_KEY_4=your_gemini_api_key_4_here

# Luồng 5 (Khóa phụ 5):
GEMINI_API_KEY_5=your_gemini_api_key_5_here

# Hoặc có thể khai báo danh sách gộp (phân tách bởi dấu phẩy):
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
