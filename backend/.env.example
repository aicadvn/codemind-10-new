# =====================================================================
# CODEMIND 10 - BACKEND ENVIRONMENT VARIABLES
# Hướng dẫn: Đổi tên thành .env và điền các khóa bí mật của bạn
# =====================================================================

PORT=5000

# 1. Khóa Google Gemini API (Lấy miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Mật khẩu dùng chung cho lớp học (Chế độ dự phòng khi phòng máy không dùng Gmail)
APP_PASSCODE=TIN10_2026
