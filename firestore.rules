rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kiểm tra tài khoản Giáo viên dựa trên email đăng nhập Google
    function isTeacher() {
      return request.auth != null && 
        (request.auth.token.email == 'smilers.thp@gmail.com' || 
         request.auth.token.email == 'tranthingalg1@gmail.com' || 
         request.auth.token.email == 'nguyentrunghoa@gmail.com');
    }

    // Kiểm tra học sinh chính chủ sở hữu tài liệu
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Quản lý hồ sơ người dùng (học sinh & giáo viên)
    match /users/{userId} {
      // Giáo viên có quyền ĐỌC dữ liệu tất cả học sinh để hiển thị Teacher Dashboard
      // Học sinh có toàn quyền ĐỌC & GHI thông tin tài khoản của chính mình
      allow read: if isOwner(userId) || isTeacher();
      allow write: if isOwner(userId);

      // Tất cả các sub-collections: codeSnippets, debugLogs, socraticChats, sessions
      match /{allSubcollections=**} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId);
      }
    }
    
    // Chặn các truy cập ngoài danh mục
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

